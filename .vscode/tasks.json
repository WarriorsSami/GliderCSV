{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: build crawler (debug)",
            "type": "shell",
            "command": "cargo build",
            "options": {
                "cwd": "${workspaceFolder}/crawler"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "go: compile test binary (syscrawler)",
            "type": "shell",
            "command": "go test -gcflags='all=-N -l' -c ./internal/syscrawler/... -o ${workspaceFolder}/cli/syscrawler.test",
            "options": {
                "cwd": "${workspaceFolder}/cli"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$go",
            "dependsOn": "cargo: build crawler (debug)"
        },
        {
            // Run all syscrawler Go tests. Always rebuilds libcrawler.so first
            // via dependsOn so the .so is never stale relative to the source.
            "label": "go: test syscrawler",
            "type": "shell",
            "command": "go test ./internal/syscrawler/... -v",
            "options": {
                "cwd": "${workspaceFolder}/cli"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$go",
            "dependsOn": "cargo: build crawler (debug)"
        }
    ]
}
